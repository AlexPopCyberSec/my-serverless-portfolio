                </div>

            </div>
        </section>

        <section id="skills-pin-container" class="h-[100svh] w-full flex flex-col justify-center items-center overflow-hidden bg-zinc-950 relative px-4 sm:px-6 py-10 lg:py-0">
            
            <div class="w-full max-w-5xl flex flex-col gap-4 sm:gap-6 lg:gap-8 mt-4 lg:mt-0">
                
