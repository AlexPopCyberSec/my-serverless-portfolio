<script is:inline>
    function updateClocks() {
        const fmt = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
        document.getElementById('vn-time').textContent = new Date().toLocaleTimeString('en-GB', { ...fmt, timeZone: 'Asia/Ho_Chi_Minh' });
        document.getElementById('nyc-time').textContent = new Date().toLocaleTimeString('en-GB', { ...fmt, timeZone: 'America/New_York' });
        document.getElementById('ldn-time').textContent = new Date().toLocaleTimeString('en-GB', { ...fmt, timeZone: 'Europe/London' });
        document.getElementById('syd-time').textContent = new Date().toLocaleTimeString('en-GB', { ...fmt, timeZone: 'Australia/Sydney' });
    }
    setInterval(updateClocks, 1000);
    updateClocks();
</script>