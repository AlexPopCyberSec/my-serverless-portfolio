                    <div class="relative h-[55vh] lg:h-[55vh] 2xl:h-[65vh] overflow-hidden">
                        
                        <div id="term-group-1" class="absolute inset-0 flex flex-col gap-1 lg:gap-1 2xl:gap-2 p-4 lg:p-6 2xl:p-10 w-full pb-10 lg:pb-12">
                            <div class="sys-line opacity-0"><span class="text-fuchsia-500">alex@saigon</span><span class="text-zinc-500">:$</span> ./load_systems.sh</div>
                            
                            <div class="sys-line opacity-0 text-cyan-400 pl-3 lg:pl-4 2xl:pl-6">[ OK ] Loaded: Windows Server 2022</div>
                            <div class="sys-line opacity-0 text-cyan-400 pl-3 lg:pl-4 2xl:pl-6">[ OK ] Loaded: Linux (Ubuntu/Kali CLI)</div>
                            <div class="sys-line opacity-0 text-cyan-400 pl-3 lg:pl-4 2xl:pl-6">[ OK ] Loaded: Active Directory (GPO)</div>
                            <div class="sys-line opacity-0 text-cyan-400 pl-3 lg:pl-4 2xl:pl-6">[ OK ] Loaded: Microsoft Entra ID</div>
                            <div class="sys-line opacity-0 text-cyan-400 pl-3 lg:pl-4 2xl:pl-6">[ OK ] Loaded: Hybrid Identity Sync</div>
