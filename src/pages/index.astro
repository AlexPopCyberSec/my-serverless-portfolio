                <div class="w-full bg-[#0a0a0c] border border-zinc-700 rounded-xl shadow-[0_0_50px_rgba(6,182,212,0.1)] overflow-hidden font-mono text-[10px] sm:text-xs lg:text-xs 2xl:text-base">
                    
                    <div class="flex items-center px-4 lg:px-6 py-2 lg:py-3 bg-zinc-900/90 border-b border-zinc-800 gap-2 z-20 relative backdrop-blur-sm">
