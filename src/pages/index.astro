---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Alex | CyberSec & IT">
    
    <main class="max-w-6xl mx-auto px-6 py-20">
        
        <section class="mb-24">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-fuchsia-950/30 border border-fuchsia-500/30 text-fuchsia-400 text-xs font-mono mb-6">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                SYSTEM STATUS: ONLINE / OPEN TO WORK
            </div>

            <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight mb-4 font-mono">
                Hello, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-fuchsia-500 to-purple-600">Alex</span>.
            </h1>
            
            <p class="text-xl md:text-2xl text-zinc-400 mb-8 max-w-2xl">
                IT Support Specialist & Future Cybersecurity Analyst. <br>
                <span class="text-zinc-500 text-base">
                    CompTIA Network+ Certified specialist transitioning from education back to enterprise IT. 
                    I combine strong technical troubleshooting with elite communication skills to solve problems fast. 
                    <strong class="text-zinc-400">Actively seeking IT Support & Help Desk opportunities.</strong>
                </span>
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
                <a href="mailto:aleksandarpopovfx@gmail.com" class="px-6 py-3 bg-fuchsia-700 hover:bg-fuchsia-600 text-white font-bold rounded hover:shadow-[0_0_20px_rgba(217,70,239,0.4)] transition-all">
                    Contact Me
                </a>
                <a href="/CV-Public.pdf" target="_blank" rel="noopener noreferrer" class="px-6 py-3 border border-zinc-700 hover:border-fuchsia-500 hover:text-fuchsia-400 text-zinc-300 rounded transition-all">
                    Download CV
                </a>
                <a href="https://github.com/AlexPopCyberSec" target="_blank" rel="noopener noreferrer" class="px-6 py-3 border border-zinc-700 hover:border-violet-500 hover:text-violet-400 text-zinc-300 rounded transition-all flex items-center gap-2 group">
  <svg class="w-5 h-5 fill-current text-zinc-500 group-hover:text-violet-500 transition-colors" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
  </svg>
  <span>GitHub</span>
</a>
            </div>
        </section>

        <section class="mb-16">
            <h2 class="text-2xl font-mono text-white mb-8 border-l-4 border-fuchsia-600 pl-4">./CERTIFICATES</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="p-6 rounded bg-zinc-900/50 border border-zinc-800 hover:border-fuchsia-500 transition-all group">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-white group-hover:text-fuchsia-400 font-mono">CompTIA A+</h3>
                        <span class="px-2 py-1 bg-fuchsia-950 text-fuchsia-300 text-[10px] rounded font-mono border border-fuchsia-500/20">CERTIFIED</span>
                    </div>
                    <p class="text-zinc-400 text-sm">Hardware diagnostics, Windows/Linux Administration, Security basics & Mobile devices.</p>
                </div>

                <div class="p-6 rounded bg-zinc-900/50 border border-zinc-800 hover:border-violet-500 transition-all group">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-white group-hover:text-violet-400 font-mono">Network+</h3>
                        <span class="px-2 py-1 bg-violet-950 text-violet-300 text-[10px] rounded font-mono border border-violet-500/20">CERTIFIED</span>
                    </div>
                    <div class="w-full bg-zinc-800 rounded-full h-1 mb-2">
                        <div class="bg-violet-600 h-1 rounded-full shadow-[0_0_10px_rgba(139,92,246,0.5)]" style="width: 100%"></div>
                    </div>
                    <p class="text-zinc-400 text-sm">TCP/IP, DNS/DHCP, Subnetting, VLANs, Routing protocols & Network troubleshooting.</p>
                </div>

                <div class="p-6 rounded bg-zinc-900/50 border border-zinc-800 hover:border-orange-500 transition-all group">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-white group-hover:text-orange-400 font-mono">Security+</h3>
                        <span class="px-2 py-1 bg-zinc-800 text-zinc-400 text-[10px] rounded font-mono">IN PROGRESS</span>
                    </div>
                    <div class="w-full bg-zinc-800 rounded-full h-1 mb-2">
                        <div class="bg-orange-500 h-1 rounded-full shadow-[0_0_10px_rgba(249,115,22,0.5)]" style="width: 30%"></div>
                    </div>
                    <p class="text-zinc-400 text-sm">Threat Analysis, Risk Management, Cryptography, Incident Response & Security Architecture.</p>
                </div>
            </div>
        </section>

        <section class="mb-24">
            <h2 class="text-2xl font-mono text-white mb-8 border-l-4 border-cyan-500 pl-4">./TECHNICAL_SKILLS</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                
                <div class="p-6 rounded bg-zinc-900/50 border border-zinc-800 hover:border-cyan-500/50 transition-all">
                    <h3 class="text-lg font-bold text-white mb-4 font-mono text-cyan-400">>> Systems_&_Security</h3>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-cyan-900 hover:text-cyan-200 transition-colors cursor-default">Windows Server 2022</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-cyan-900 hover:text-cyan-200 transition-colors cursor-default">Linux (Ubuntu/Kali CLI)</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-cyan-900 hover:text-cyan-200 transition-colors cursor-default">Active Directory (GPO)</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-cyan-900 hover:text-cyan-200 transition-colors cursor-default">Malware Remediation</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-cyan-900 hover:text-cyan-200 transition-colors cursor-default">IAM / Access Control</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-cyan-900 hover:text-cyan-200 transition-colors cursor-default">DNS/DHCP Management</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-cyan-900 hover:text-cyan-200 transition-colors cursor-default">Disaster Recovery</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-cyan-900 hover:text-cyan-200 transition-colors cursor-default">VPN & Remote Access</span>
                    </div>
                </div>

                <div class="p-6 rounded bg-zinc-900/50 border border-zinc-800 hover:border-purple-500/50 transition-all">
                    <h3 class="text-lg font-bold text-white mb-4 font-mono text-purple-400">>> Tools_&_Cloud</h3>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-purple-900 hover:text-purple-200 transition-colors cursor-default">VirtualBox / VMware</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-purple-900 hover:text-purple-200 transition-colors cursor-default">Wireshark (Packet Analysis)</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-purple-900 hover:text-purple-200 transition-colors cursor-default">Git / GitHub</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-purple-900 hover:text-purple-200 transition-colors cursor-default">Astro / Tailwind</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-purple-900 hover:text-purple-200 transition-colors cursor-default">Jira / Ticketing Systems</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-purple-900 hover:text-purple-200 transition-colors cursor-default">Office 365 Admin</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-purple-900 hover:text-purple-200 transition-colors cursor-default">Nmap</span>
                        <span class="px-3 py-1 bg-zinc-800 text-xs text-zinc-300 rounded hover:bg-purple-900 hover:text-purple-200 transition-colors cursor-default">Cloudflare Pages</span>
                    </div>
                </div>

            </div>
        </section>

        <section class="mb-24">
            <h2 class="text-2xl font-mono text-white mb-8 border-l-4 border-purple-600 pl-4">./HOME_LABS_&_PROJECTS</h2>
            
            <div class="space-y-4">
                
                <div class="group relative p-6 bg-zinc-900/50 border border-zinc-800 hover:border-fuchsia-500/50 transition-all rounded">
                    <div class="absolute -left-[1px] top-0 bottom-0 w-[4px] bg-fuchsia-600 scale-y-0 group-hover:scale-y-100 transition-transform"></div>
                    <h3 class="text-lg font-bold text-white mb-2 font-mono group-hover:text-fuchsia-400">Enterprise Infrastructure Lab</h3>
                    <p class="text-zinc-400 mb-4 text-sm">
                        Deployed a Windows Server 2022 Domain Controller in a virtualized environment. configured AD DS, managed User/Group permissions, and implemented Group Policy Objects (GPOs). Simulated a corporate topology with DNS/DHCP roles for connected Windows 11 & Linux clients.
                    </p>
                    <div class="flex gap-3 text-xs font-mono text-fuchsia-500">
                        <span>> Active Directory</span>
                        <span>> GPO Management</span>
                        <span>> VirtualBox</span>
                    </div>
                </div>

                <div class="group relative p-6 bg-zinc-900/50 border border-zinc-800 hover:border-red-500/50 transition-all rounded">
                    <div class="absolute -left-[1px] top-0 bottom-0 w-[4px] bg-red-600 scale-y-0 group-hover:scale-y-100 transition-transform"></div>
                    <h3 class="text-lg font-bold text-white mb-2 font-mono group-hover:text-red-400">Cybersecurity Forensics (MVT)</h3>
                    <p class="text-zinc-400 mb-4 text-sm">
                        Utilized the Mobile Verification Toolkit (MVT) via Linux CLI to analyze Android backup images. Scanned for Indicators of Compromise (IOCs) related to spyware threats (Pegasus/Predator) to verify device integrity.
                    </p>
                    <div class="flex gap-3 text-xs font-mono text-red-500">
                        <span>> Linux CLI</span>
                        <span>> Digital Forensics</span>
                        <span>> IOC Scanning</span>
                    </div>
                </div>

                <div class="group relative p-6 bg-zinc-900/50 border border-zinc-800 hover:border-purple-500/50 transition-all rounded">
                     <div class="absolute -left-[1px] top-0 bottom-0 w-[4px] bg-purple-600 scale-y-0 group-hover:scale-y-100 transition-transform"></div>
                    <h3 class="text-lg font-bold text-white mb-2 font-mono group-hover:text-purple-400">Personal Portfolio (This Website)</h3>
                    <p class="text-zinc-400 mb-4 text-sm">
                        Serverless deployment using Astro & Tailwind. Configured custom domain DNS records via Cloudflare, set up SSL/TLS encryption, and integrated a CI/CD pipeline via GitHub Actions for automated edge deployment.
                    </p>
                    <div class="flex gap-3 text-xs font-mono text-purple-500">
                        <span>> Cloudflare Pages</span>
                        <span>> Astro</span>
                        <span>> CI/CD</span>
                    </div>
                </div>

                <div class="group relative p-6 bg-zinc-900/50 border border-zinc-800 hover:border-blue-500/50 transition-all rounded">
                    <div class="absolute -left-[1px] top-0 bottom-0 w-[4px] bg-blue-600 scale-y-0 group-hover:scale-y-100 transition-transform"></div>
                    <div class="flex justify-between items-start">
                        <h3 class="text-lg font-bold text-white mb-2 font-mono group-hover:text-blue-400">Lingo Leap (Production Site)</h3>
                        <a href="https://lingo-leap.net" target="_blank" rel="noopener noreferrer" class="text-xs border border-blue-500/30 text-blue-400 px-2 py-1 rounded hover:bg-blue-500 hover:text-white transition-colors">
                            VISIT SITE ↗
                        </a>
                    </div>
                    <p class="text-zinc-400 mb-4 text-sm">
                        Developed and deployed a high-performance marketing platform for an online language school. Engineered with Astro for static site generation (SSG) to maximize load speeds and SEO. Implemented responsive design with Tailwind CSS and deployed via edge networks for global availability.
                    </p>
                    <div class="flex gap-3 text-xs font-mono text-blue-500">
                        <span>> Web Development</span>
                        <span>> Production Deployment</span>
                        <span>> DNS Management</span>
                    </div>
                </div>

            </div>
        </section>

        <footer class="text-center text-zinc-600 text-xs font-mono pb-10 pt-10 border-t border-zinc-900">
            <p>echo "Alex @ Saigon";</p>
        </footer>

    </main>
</Layout>