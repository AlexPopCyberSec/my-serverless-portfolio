                            <div class="sys-clear opacity-0 mt-2"><span class="text-fuchsia-500">alex@saigon</span><span class="text-zinc-500">:$</span> clear</div>
                        </div>

                        <div id="term-group-2" class="absolute inset-0 flex flex-col gap-1 lg:gap-1 2xl:gap-2 p-4 lg:p-6 2xl:p-10 w-full opacity-0 pb-10 lg:pb-12">
                            <div class="tool-line opacity-0"><span class="text-fuchsia-500">alex@saigon</span><span class="text-zinc-500">:$</span> ./load_tools.exe</div>
                            
                            <div class="tool-line opacity-0 text-purple-400 pl-3 lg:pl-4 2xl:pl-6">[ OK ] Init: Proxmox VE (Type-1 Hypervisor)</div>
                            <div class="tool-line opacity-0 text-purple-400 pl-3 lg:pl-4 2xl:pl-6">[ OK ] Init: VirtualBox / VMware</div>
