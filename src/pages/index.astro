<script is:inline>
    // 1. SATOVI
    function updateClocks() {
        const fmt = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
        const vnEl = document.getElementById('vn-time');
        const nycEl = document.getElementById('nyc-time');
        const ldnEl = document.getElementById('ldn-time');
        const sydEl = document.getElementById('syd-time');
        
        if(vnEl) vnEl.textContent = new Date().toLocaleTimeString('en-GB', { ...fmt, timeZone: 'Asia/Ho_Chi_Minh' });
        if(nycEl) nycEl.textContent = new Date().toLocaleTimeString('en-GB', { ...fmt, timeZone: 'America/New_York' });
        if(ldnEl) ldnEl.textContent = new Date().toLocaleTimeString('en-GB', { ...fmt, timeZone: 'Europe/London' });
        if(sydEl) sydEl.textContent = new Date().toLocaleTimeString('en-GB', { ...fmt, timeZone: 'Australia/Sydney' });
    }
    setInterval(updateClocks, 1000);
    updateClocks();

    // 2. GSAP MAESTRO LOGIKA (Čist Native Scroll)
    document.addEventListener("DOMContentLoaded", () => {
        if(typeof gsap !== 'undefined') {
            
            gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

            // Obavezno podešavanje da bi Native Scroll lepo radio sa pinovanjem
            ScrollTrigger.config({ limitCallbacks: true });
            // Ovo osigurava da se kalkulacije visine ne zaglupe
            ScrollTrigger.normalizeScroll(false); 

            // --- BACK TO TOP LOGIKA ---
            const bttButton = document.getElementById('back-to-top');
            if (bttButton) {
                window.addEventListener("scroll", () => {
                    if (window.scrollY > 600) {
                        bttButton.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
                        bttButton.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
                    } else {
                        bttButton.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
                        bttButton.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
                    }
                });

                bttButton.addEventListener('click', () => {
                    gsap.to(window, { duration: 1.2, scrollTo: 0, ease: "power3.inOut" });
                });
            }
            // --------------------------

            // A. Učitavanje stranice
            gsap.to(".gsap-header", { opacity: 1, y: 0, duration: 1, ease: "power3.out" });
            gsap.to("#hero-section", { opacity: 1, duration: 1.5, ease: "power2.out", delay: 0.5 });

            // B. Hero -> Incident Response (UBRZANO)
            const tlHeroIR = gsap.timeline({
                scrollTrigger: {
                    trigger: "#hero-ir-container",
                    start: "top top",
                    end: "+=100%", 
                    scrub: 1, 
                    pin: true 
                }
            });
            tlHeroIR.to("#hero-section", { opacity: 0, scale: 0.9, duration: 1 })
                    .to("#ir-section", { opacity: 1, scale: 1, pointerEvents: "auto", duration: 1.5 }, "-=0.5");

            // C. Home Labs
            const labsTrack = document.getElementById('labs-track');
            if(labsTrack) {
                let labsTween = gsap.to(labsTrack, {
                    x: () => -(labsTrack.scrollWidth - window.innerWidth),
                    ease: "none",
                    scrollTrigger: {
                        trigger: "#labs-pin-container",
                        start: "top top",
                        end: () => `+=${labsTrack.scrollWidth * 0.8}`, 
                        scrub: 1,
                        pin: true,
                        invalidateOnRefresh: true
                    }
                });

                gsap.utils.toArray('.lab-card').forEach(card => {
                    const tlCard = gsap.timeline({
                        scrollTrigger: {
                            trigger: card,
                            containerAnimation: labsTween,
                            start: "left 95%", 
                            end: "right 5%",   
                            scrub: true
                        }
                    });

                    tlCard.fromTo(card, 
                        { opacity: 0, scale: 0.75 }, 
                        { opacity: 1, scale: 1, duration: 0.2, ease: "power2.out" } 
                    )
                    .to(card, 
                        { opacity: 1, scale: 1, duration: 0.6 } 
                    )
                    .to(card, 
                        { opacity: 0, scale: 0.75, duration: 0.2, ease: "power2.in" } 
                    );
                });
            }

            // D. Technical Skills (UBRZANO)
            const tlTerminal = gsap.timeline({
                scrollTrigger: {
                    trigger: "#skills-pin-container",
                    start: "top top",
                    end: "+=250%", 
                    scrub: 1,
                    pin: true,
                    invalidateOnRefresh: true
                }
            });

            tlTerminal.to(".sys-line", { opacity: 1, stagger: 0.08, ease: "none" });
            tlTerminal.to(".sys-clear", { opacity: 1, duration: 0.15 }, "+=0.15");
            tlTerminal.to("#term-group-1", { opacity: 0, duration: 0.01 }, "+=0.15")
                      .to("#term-group-2", { opacity: 1, duration: 0.01 }, "<");
            tlTerminal.to(".tool-line", { opacity: 1, stagger: 0.08, ease: "none" });

            // E. BPA Solutions (FILMSKI ULAZ - OPCIJA B)
            const bpaTrack = document.getElementById('bpa-cards-track');
            if (bpaTrack) {
                const tlBpa = gsap.timeline({
                    scrollTrigger: {
                        trigger: "#bpa-section",
                        start: "top top",
                        end: "+=200%", 
                        scrub: 1,
                        pin: true,
                        invalidateOnRefresh: true,
                        onEnter: () => { gsap.to(".blob-1", { backgroundColor: "#10b981", opacity: 0.15, duration: 1 }); },
                        onLeave: () => { gsap.to(".blob-1", { backgroundColor: "#c026d3", opacity: 0.2, duration: 1 }); },
                        onEnterBack: () => { gsap.to(".blob-1", { backgroundColor: "#10b981", opacity: 0.15, duration: 1 }); },
                        onLeaveBack: () => { gsap.to(".blob-1", { backgroundColor: "#c026d3", opacity: 0.2, duration: 1 }); }
                    }
                });

                // 1. KORAK: Tekst levo ulazi prvi (od 0 do 0.4 sekunde na timeline-u)
                tlBpa.fromTo(".bpa-intro-text", 
                    { opacity: 0, y: 20 }, 
                    { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, 
                    0 
                );

                // 2. KORAK: Kartice kreću odozdo, izvan vidokruga, tek nakon teksta (startuju na 0.4)
                tlBpa.fromTo(bpaTrack, 
                    { y: () => bpaTrack.parentElement.offsetHeight }, // Početak: Gurnuto skroz dole ispod overflow-hidden granice
                    {
                        y: () => -(bpaTrack.scrollHeight - bpaTrack.parentElement.offsetHeight), // Kraj: Skrol do poslednje kartice
                        ease: "none",
                        duration: 2
                    }, 
                    0.4 // Ovo je ključ: animacija kartica čeka da tekst završi!
                );
            }

            // F. Certificates (UBRZANO)
            const certCards = gsap.utils.toArray('.cert-card');
            if(certCards.length > 0) {
                gsap.set(certCards, { y: window.innerHeight, opacity: 0 });
                gsap.set(certCards[0], { y: 0, opacity: 1 });

                const tlCerts = gsap.timeline({
                    scrollTrigger: {
                        trigger: "#certs-pin-container",
                        start: "top top",
                        end: "+=" + (certCards.length * 45) + "%", 
                        scrub: 1,
                        pin: true,
                        invalidateOnRefresh: true
                    }
                });

                certCards.forEach((card, index) => {
                    if (index === 0) return; 

                    tlCerts.to(certCards.slice(0, index), {
                        y: (i) => -35 * (index - i), 
                        scale: (i) => 1 - 0.05 * (index - i), 
                        duration: 1,
                        ease: "power2.out"
                    }, index);

                    tlCerts.to(card, { y: 0, opacity: 1, duration: 1, ease: "power2.out" }, index);
                });
            }

            // Parallax blurevi u pozadini
            gsap.to(".blob-1", { yPercent: 100, ease: "none", scrollTrigger: { trigger: "body", start: "top top", end: "bottom top", scrub: 1 } });
            gsap.to(".blob-2", { yPercent: -100, ease: "none", scrollTrigger: { trigger: "body", start: "top top", end: "bottom top", scrub: 1 } });

            ScrollTrigger.refresh();
        }
    });
</script>